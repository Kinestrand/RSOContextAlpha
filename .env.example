# Optional Jev fuse (rso-context jev-fuse). Core RSO needs none of this.
# Copy to .env in this checkout, or set the variables in your shell.
# Use your own Experiential Labs key. Never commit .env.
EXPERIENTIAL_API_KEY=
# Turn the fuse on (it is off by default):
# RSO_JEV_ENABLED=1
# Optional overrides:
# RSO_JEV_URL=https://api.experientiallabs.ai/v1/systemone
# RSO_JEV_MODEL=jev-latest
